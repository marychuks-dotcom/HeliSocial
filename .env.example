# ==============================================================================
# HELISOCIAL PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure the variables for your deployment.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# 1. RUNTIME CONFIGURATION
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# 2. SECURITY & SESSION MANAGEMENT
# Generate a cryptographically secure 64-character random hex string for each
JWT_SECRET=replace_with_64_char_random_jwt_secret_min_32_chars
SESSION_SECRET=replace_with_64_char_random_session_secret

# 3. DATABASE CONNECTION
# Standard PostgreSQL connection string (compatible with Cloud SQL, Supabase, Neon, RDS)
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/helisocial_db

# 4. GOOGLE GEMINI AI (Official @google/genai SDK)
# Required for server-side AI Content Studio generation
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key

# 5. STRIPE BILLING & SUBSCRIPTION REVENUE
# Obtain keys from Stripe Dashboard (Developers -> API Keys & Webhooks)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# Configurable Stripe Price IDs for the 3 paid subscription tiers
STRIPE_PRICE_ID_CREATOR=price_creator_monthly
STRIPE_PRICE_ID_BUSINESS=price_business_monthly
STRIPE_PRICE_ID_AGENCY=price_agency_monthly

# 6. EXTERNAL SOCIAL OAUTH APPS (Optional for external distribution)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
